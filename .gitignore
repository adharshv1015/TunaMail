# ==============================================================================
# TunaMail Unified .gitignore
# ==============================================================================

# ==============================================================================
# 1. Operating System Files
# ==============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
*.bak
*.backup
*.old
*.swp
*.swo
*.swn

# ==============================================================================
# 2. Editors & IDEs
# ==============================================================================
.idea/
.vscode/
!.vscode/extensions.json
*.code-workspace
.settings/
.classpath
.project
.cursor/
.windsurf/
.claude/
.aider*
*.sublime-project
*.sublime-workspace

# ==============================================================================
# 3. AI Agents & Local Scratch Directories
# ==============================================================================
.gemini/
.agents/
feedback_backup/
scratch/
backend/scratch/
**/scratch/
**/scratch/**
scratch*
*scratch*

# ==============================================================================
# 4. Machine Learning & Model Checkpoints
# ==============================================================================
*.before_*.pkl
*.backup.pkl
*.pkl.bak
backend/src/ai/models/*.before_*
backend/src/ai/models/*.backup*
backend/src/ai/models/*.bak
backend/src/ai/models/*_backup.*

# ==============================================================================
# 5. Frontend & Node.js (Vite, React, Vanilla)
# ==============================================================================
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
build/
.npm/
.vite/
frontend/.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
.eslintcache
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.local

# ==============================================================================
# 6. Python & FastAPI Backend
# ==============================================================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
develop-eggs/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Typing & Linting Caches
.mypy_cache/
.ruff_cache/
backend/.mypy_cache/
backend/.ruff_cache/

# Pytest & Coverage
.pytest_cache/
backend/.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.tox/
.nox/

# ==============================================================================
# 7. Virtual Environments
# ==============================================================================
.venv/
backend/.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt

# ==============================================================================
# 8. Environment Variables & Secrets
# ==============================================================================
.env
.env.*
!.env.example
!backend/.env.example
backend/.env
backend/.env.*

# Certificates, Keys & Secrets
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
*credentials*.json
*token*.json

# Templates & Schemas Kept Intact
!backend/client_secret.json
!backend/openapi_test.json

# ==============================================================================
# 9. Databases & Persistence (SQLite / WAL)
# ==============================================================================
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-journal
*.db-wal
*.db-shm
data/
backend/data/*.db*
backend/data/*.sqlite*
backend/intelligence/*.db*
backend/intelligence/*.sqlite*
backend/intelligence/*.json

# Keep DB seed files and directory placeholders
!backend/data/.gitkeep
!backend/data/seed_*.json

# ==============================================================================
# 10. Logs & Diagnostic Traces
# ==============================================================================
*.log
logs/
backend/logs/

# ==============================================================================
# 11. Browser Testing & Automation Artifacts (Playwright)
# ==============================================================================
test-results/
playwright-report/
blob-report/
playwright/.cache/
.playwright/

# ==============================================================================
# 12. File Uploads, Test Emails & Artifacts
# ==============================================================================
backend/uploads/
backend/reports/
backend/test_certs/
*.eml
backend/*.eml
backend/output*.json
backend.zip

# Prevent ignoring critical configuration files
!requirements.txt
!requirements*.txt
!backend/requirements.txt
!backend/requirements*.txt
!package.json
!package-lock.json
!frontend/package.json
!frontend/package-lock.json

# Test & Scratch Runner Scripts
backend/stage16_test.py
backend/test_*.py
backend/inspection_timing.py
backend/phishing_test.eml
backend/private_ip_test.eml
backend/test_email.txt